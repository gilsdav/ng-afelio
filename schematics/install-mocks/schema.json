{
    "$schema": "http://json-schema.org/schema",
    "$id": "SchematicsNgAfelioMocksSystem",
    "title": "ng-afelio Generate mocks system",
    "type": "object",
    "properties": {
        "project": {
            "type": "string",
            "description": "The name of the project",
            "$default": {
                "$source": "projectName"
            }
        },
        "appModule": {
            "type": "string",
            "description": "The path of the AppModule (relativePath from project folder)",
            "default": "app.module.ts"
        },
        "appConfig": {
            "type": "string",
            "description": "The path of the AppConfig (relativePath from project folder)",
            "default": "app.config.ts"
        },
        "auth": {
            "type": "boolean",
            "description": "Add auth mocks",
            "default": true
        }
    },
    "required": []
}